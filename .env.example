# Application Port & Mode
PORT=3000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# Neon Database (neon.tech / neon.com) or PostgreSQL
# Opsi 1: Masukkan Connection String Neon langsung dari Neon Console (Dashboard -> Connection Details)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=
NEON_DATABASE_URL=

# Opsi 2: Konfigurasi Terpisah (Standard PostgreSQL / Local / Cloud SQL)
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=medikacheck
SQL_USER=medika_user
SQL_PASSWORD=your_secure_password
SQL_ADMIN_USER=medika_user
SQL_ADMIN_PASSWORD=your_secure_password
DB_SSL=false

# Gemini AI API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
APP_URL=http://localhost:3000
